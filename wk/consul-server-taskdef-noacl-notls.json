{
    "compatibilities": [
        "EC2",
        "FARGATE"
    ],
    "containerDefinitions": [
        {
            "command": [
                "ECS_IPV4=$(curl -s $ECS_CONTAINER_METADATA_URI_V4 | jq -r '.Networks[0].IPv4Addresses[0]')\n\nexec consul agent -server \\\n  -bootstrap \\\n  -ui \\\n  -advertise \"$ECS_IPV4\" \\\n  -client 0.0.0.0 \\\n  -data-dir /tmp/consul-data \\\n  -hcl 'node_name = \"consul-ecs-consul-server\"' \\\n  -hcl='datacenter = \"dc1\"' \\\n  -hcl 'connect { enabled = true }' \\\n  -hcl 'enable_central_service_config = true' \\\n  -hcl='ports { grpc = 8502 }' \\\n"
            ],
            "cpu": 0,
            "entryPoint": [
                "/bin/sh",
                "-ec"
            ],
            "environment": [],
            "essential": true,
            "image": "hashicorppreview/consul:1.19.0",
            "linuxParameters": {
                "initProcessEnabled": true
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "consul-ecs",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "consul-server"
                }
            },
            "mountPoints": [
                {
                    "containerPath": "/consul",
                    "sourceVolume": "consul-data"
                }
            ],
            "name": "consul-server",
            "portMappings": [
                {
                    "containerPort": 8301,
                    "hostPort": 8301,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8300,
                    "hostPort": 8300,
                    "protocol": "tcp"
                },
                {
                    "containerPort": 8500,
                    "hostPort": 8500,
                    "protocol": "tcp"
                }
            ],
            "secrets": [],
            "systemControls": [],
            "volumesFrom": []
        }
    ],
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::352100722351:role/ecs/consul-ecs-consul-server_execution",
    "family": "consul-ecs-consul-server",
    "memory": "512",
    "networkMode": "awsvpc",
    "placementConstraints": [],
